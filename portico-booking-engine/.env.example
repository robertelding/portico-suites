# ── Portico Suites Booking Engine — environment configuration ──
# Copy to .env and fill in. NEVER commit .env to version control.

# Hospitable (Apps → API access → Access tokens · PATs last 1 year — diarise renewal)
HOSPITABLE_API_BASE=https://public.api.hospitable.com/v2
HOSPITABLE_TOKEN=
HOSPITABLE_PROPERTY_ID=
HOSPITABLE_WEBHOOK_SECRET=

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Pricing display
CURRENCY=gbp
DIRECT_SAVINGS_PCT=12          # "Direct Savings: 12% vs Airbnb" banner figure

# Admin alerting (Slack/Teams incoming webhook or similar) — Yale fallback + disputes
ALERT_WEBHOOK_URL=

# Server
PORT=3000
SITE_ORIGIN=https://porticosuites.com   # CORS allow-origin for the booking widget

# Meta (Facebook) Ads — token scoped to ONE ad account (ads_management)
META_DRIVER=cli                # 'cli' = official Meta Ads CLI (preferred) · 'api' = raw Graph API fallback
META_CLI_BIN=meta              # path to the CLI binary if not on PATH (Python 3.12+, pip/uv install)
META_ACCESS_TOKEN=
META_AD_IMAGE_PATHS=           # CLI driver: comma-separated LOCAL file paths of ad images on the server
META_AD_IMAGE_URLS=            # API fallback: comma-separated public https URLs of ad images
CMS_ADMIN_KEY=                 # shared secret; must match "Admin key" in the CMS Facebook Ads panel
